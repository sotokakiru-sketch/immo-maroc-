[TEMPLATE]
# =============================================================================
#  DarFind / Immo Maroc — Exemple de configuration
#  Copiez ce fichier en .env puis adaptez les valeurs à votre environnement.
#  NE commitez JAMAIS de vraies valeurs dans .env (secret).
# =============================================================================

# 1) Connexion à la base PostgreSQL (Drizzle) — hébergée chez Supabase
#    Format : postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres.REF:password@aws-0-eu-north-1.pooler.supabase.com:6543/postgres

# 2) Supabase Auth (URL du projet + clé anon — publiques, inlinées au build)
#    URL : https://<ref>.supabase.co — clé anon : dashboard Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=collez-votre-cle-anon

# 3) E-mails des comptes administrateurs (séparés par des virgules).
#    Les utilisateurs Supabase Auth dont l'e-mail est listé ici ont le rôle admin.
ADMIN_EMAILS=immomaroc.org@gmail.com

# 4) (Script legacy seed-admin.mjs, plus utilisé par l'app — auth via Supabase)
#    Utilisées uniquement par : `node seed-admin.mjs`
ADMIN_SEED_EMAIL=admin@immomaroc.ma
ADMIN_SEED_PASSWORD=choisissez-un-mot-de-passe-solide