# =============================================================================
#  DarFind / Immo Maroc — Exemple de configuration
#  Copiez ce fichier en .env puis adaptez les valeurs à votre environnement.
#  NE commitez JAMAIS de vraies valeurs dans .env (secret).
# =============================================================================

# 1) Connexion à la base PostgreSQL (Drizzle)
#    Format : postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# 2) Clé secrète de signature des sessions (HMAC-SHA256)
#    OBLIGATOIRE. Utilisez une chaîne longue et unique (ex: openssl rand -hex 32).
SESSION_SECRET=remplacez-par-une-chaine-longue-et-secrete

# 3) & 4) Compte administrateur principal
#    Utilisées uniquement par le script d'initialisation : `node seed-admin.mjs`
#    L'inscription publique (/signup) ne crée QUE des comptes clients.
ADMIN_SEED_EMAIL=admin@immomaroc.ma
ADMIN_SEED_PASSWORD=choisissez-un-mot-de-passe-solide
